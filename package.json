    "@mui/material": "^7.3.2",
    "@mui/styled-engine-sc": "^7.3.2",
    "@tailwindcss/vite": "^4.2.2",
    "firebase": "^11.10.0",
    "framer-motion": "^12.23.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "react-responsive": "^10.0.1",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
